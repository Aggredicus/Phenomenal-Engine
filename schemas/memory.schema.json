{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/phenomenal-engine/memory.schema.json",
  "title": "Phenomenal Engine Persistent Memory",
  "type": "object",
  "required": [
    "schema_version",
    "engine_version",
    "session_id",
    "mod",
    "turn",
    "master_seed",
    "rng_streams",
    "world_state",
    "event_ledger"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "engine_version": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "mod": {
      "type": "object"
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "master_seed": {
      "type": "string"
    },
    "rng_streams": {
      "type": "object"
    },
    "world_state": {
      "type": "object"
    },
    "characters": {
      "type": "object"
    },
    "relationships": {
      "type": "object"
    },
    "quests": {
      "type": "object"
    },
    "beliefs": {
      "type": "object"
    },
    "facts": {
      "type": "object"
    },
    "open_threads": {
      "type": "array"
    },
    "long_term_consequences": {
      "type": "array"
    },
    "chronicle": {
      "type": "array"
    },
    "event_ledger": {
      "type": "array"
    },
    "image_jobs": {
      "type": "array"
    },
    "last_scene_packet": {
      "type": [
        "object",
        "null"
      ]
    },
    "summaries": {
      "type": "object"
    },
    "story_state": {
      "type": "object"
    },
    "player_experience": {
      "type": "object"
    },
    "travel_state": {
      "type": "object"
    },
    "player_identity": {
      "type": "object",
      "required": [
        "name",
        "alias",
        "title"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
