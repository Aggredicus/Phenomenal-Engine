{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/phenomenal-engine/memory.schema.json",
  "title": "Phenomenal Engine Persistent Memory",
  "type": "object",
  "required": [
    "schema_version",
    "engine_version",
    "session_id",
    "mod",
    "turn",
    "master_seed",
    "rng_streams",
    "world_state",
    "event_ledger"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "engine_version": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "mod": {
      "type": "object"
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "master_seed": {
      "type": "string"
    },
    "rng_streams": {
      "type": "object"
    },
    "world_state": {
      "type": "object"
    },
    "characters": {
      "type": "object"
    },
    "relationships": {
      "type": "object"
    },
    "quests": {
      "type": "object"
    },
    "beliefs": {
      "type": "object"
    },
    "facts": {
      "type": "object"
    },
    "open_threads": {
      "type": "array"
    },
    "long_term_consequences": {
      "type": "array"
    },
    "chronicle": {
      "type": "array"
    },
    "event_ledger": {
      "type": "array"
    },
    "image_jobs": {
      "type": "array"
    },
    "summaries": {
      "type": "object"
    }
  }
}
