{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored campaign command",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "npc_id",
        "topic_id"
      ],
      "properties": {
        "kind": {
          "const": "talk"
        },
        "npc_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "topic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "scene_id",
        "choice_id"
      ],
      "properties": {
        "kind": {
          "const": "choose"
        },
        "scene_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "choice_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "policy",
        "npc_ids"
      ],
      "properties": {
        "kind": {
          "const": "propose_cooperation"
        },
        "policy": {
          "enum": [
            "emergency_comms",
            "coordinated_route"
          ]
        },
        "npc_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ren_ivo",
              "sister_cairn",
              "mara_ves"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
